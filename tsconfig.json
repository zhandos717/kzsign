{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node", "chrome"],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "test", "spike", "scripts"]
}
